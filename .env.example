# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
# Web origins allowed to call the API, comma-separated.
CORS_ORIGINS=http://localhost:3000

# Local PostgreSQL (see scripts/create-local-db.sql). On Supabase use the pooled URL
# (port 6543, ?pgbouncer=true) for DATABASE_URL and the direct URL (port 5432) for DIRECT_URL.
DATABASE_URL=postgresql://rentxplay:rentxplay_local@localhost:5432/rentxplay
DIRECT_URL=postgresql://rentxplay:rentxplay_local@localhost:5432/rentxplay

# Password given to every seeded demo user (npm run db:seed).
SEED_PASSWORD=

# Signs access tokens (HS256). At least 32 characters; a different random value per environment.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
